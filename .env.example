# Required: at least one provider
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: additional providers & data sources
GEMINI_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Orchestration settings
FORGE_DEFAULT_PROVIDER=claude   # claude | openai | gemini
FORGE_MAX_AGENTS=4
FORGE_WORKSPACE=~/.forge-ml
